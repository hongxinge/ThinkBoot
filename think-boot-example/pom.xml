<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.thinkboot</groupId>
        <artifactId>think-boot</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>think-boot-example</artifactId>
    <packaging>jar</packaging>
    <name>ThinkBoot Example</name>
    <description>Example project demonstrating ThinkBoot usage</description>

    <dependencies>
        <dependency>
            <groupId>com.thinkboot</groupId>
            <artifactId>think-boot-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.thinkboot</groupId>
            <artifactId>think-boot-database</artifactId>
        </dependency>
        <dependency>
            <groupId>com.thinkboot</groupId>
            <artifactId>think-boot-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.thinkboot</groupId>
            <artifactId>think-boot-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>